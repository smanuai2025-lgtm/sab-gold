# ═══════════════════════════════════════════════════════════════════
# SabeekaGold - Production Environment Variables
# ═══════════════════════════════════════════════════════════════════
# انسخ هذا الملف إلى .env وعدّل القيم

# ═══════════════════════════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════════════════════════
DATABASE_CONNECTION_STRING=Server=your-server;Database=SabeekaGoldDb;User Id=your-user;Password=your-password;TrustServerCertificate=True;
REDIS_CONNECTION_STRING=your-redis-server:6379,password=your-redis-password

# ═══════════════════════════════════════════════════════════════════
# JWT Authentication
# ═══════════════════════════════════════════════════════════════════
# استخدم مفتاح قوي (64 حرف على الأقل)
JWT_SECRET_KEY=YOUR_SUPER_SECURE_JWT_SECRET_KEY_MINIMUM_64_CHARACTERS_LONG_HERE!@#$%^&*

# ═══════════════════════════════════════════════════════════════════
# Domain & CORS
# ═══════════════════════════════════════════════════════════════════
DOMAIN=sabeekagold.com
ALLOWED_HOSTS=sabeekagold.com,www.sabeekagold.com,api.sabeekagold.com
ALLOWED_ORIGINS=https://sabeekagold.com,https://www.sabeekagold.com

# ═══════════════════════════════════════════════════════════════════
# API Keys - External Services
# ═══════════════════════════════════════════════════════════════════
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
NEWSDATA_API_KEY=your_newsdata_key
GNEWS_API_KEY=your_gnews_key
MARKETAUX_API_KEY=your_marketaux_key
GOLD_API_KEY=your_gold_api_key

# ═══════════════════════════════════════════════════════════════════
# Gemini AI (Frontend)
# ═══════════════════════════════════════════════════════════════════
GEMINI_API_KEY=your_gemini_api_key

# ═══════════════════════════════════════════════════════════════════
# SSL/TLS
# ═══════════════════════════════════════════════════════════════════
SSL_CERT_PATH=/etc/letsencrypt/live/sabeekagold.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/sabeekagold.com/privkey.pem

# ═══════════════════════════════════════════════════════════════════
# Docker Registry (اختياري)
# ═══════════════════════════════════════════════════════════════════
DOCKER_REGISTRY=your-registry.azurecr.io
DOCKER_IMAGE_TAG=latest
